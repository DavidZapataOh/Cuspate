#!/usr/bin/env sh
# Reports on staged files. It never rewrites them and it never runs the suite.
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

solidity=$(printf "%s\n" "$staged" | grep -E "\.sol$" || true)
web=$(printf "%s\n" "$staged" | grep -E "\.(ts|tsx|js|jsx|json|jsonc)$" || true)

if [ -n "$solidity" ]; then
	# The project root, or the formatter finds no configuration here and falls back to
	# its own defaults, which demand the opposite of what the project's settings produce.
	# shellcheck disable=SC2086
	forge fmt --check --root contracts $solidity
	# shellcheck disable=SC2086
	pnpm exec solhint --config contracts/.solhint.json $solidity
fi

if [ -n "$web" ]; then
	# The staged set may be entirely excluded from this gate — a generated record is, so
	# that the gate cannot rewrite it — and processing nothing is then the correct outcome
	# rather than an error. The whole-tree run still asserts it inspects a non-zero count,
	# so this cannot hide a gate that matches nothing.
	# shellcheck disable=SC2086
	pnpm exec biome ci --error-on-warnings --no-errors-on-unmatched $web
fi

# The last enforcement point before continuous integration exists. A term in a
# pushed commit message cannot be withdrawn.
# shellcheck disable=SC2086
./tools/scan-forbidden.sh $staged
