{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!contracts/lib",
			"!contracts/out",
			"!contracts/cache",
			"!contracts/broadcast",
			"!contracts/deployments",
			"!contracts/snapshots",
			"!cre/.build",
			"!cre/**/fixtures",
			"!indexer/.envio",
			"!indexer/envio-env.d.ts",
			"!web/.next",
			"!web/next-env.d.ts",
			"!web/test-results",
			"!web/playwright-report"
		]
	},
	"formatter": {
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
