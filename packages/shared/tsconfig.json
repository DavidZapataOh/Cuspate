{
	"compilerOptions": {
		"target": "esnext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
